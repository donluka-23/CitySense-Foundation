              },
              "target_time": {
                "format": "date-time",
                "title": "Target Time",
                "type": "string"
              }
            },
            "required": [
              "decision_at",
              "target_time",
              "need",
              "candidates"
            ],
            "title": "SuitabilityQuery",
            "type": "object"
          },
          "WalkingCandidate": {
            "additionalProperties": false,
            "properties": {
              "place_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_.:-]+$",
                "title": "Place Id",
                "type": "string"
              },
              "walk_minutes": {
                "maximum": 10000,
                "minimum": 0,
                "title": "Walk Minutes",
                "type": "number"
              },
              "walking_time_source": {
                "const": "caller_estimate",
                "default": "caller_estimate",
                "title": "Walking Time Source",
                "type": "string"
              }
            },
            "required": [
              "place_id",
              "walk_minutes"
            ],
            "title": "WalkingCandidate",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "city_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
