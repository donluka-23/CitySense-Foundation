        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "inputSchema": {
        "$defs": {
          "Need": {
            "enum": [
              "cool_walk",
              "quiet_rest",
              "family_walk"
            ],
            "title": "Need",
            "type": "string"
          },
          "SuitabilityQuery": {
            "additionalProperties": false,
            "properties": {
              "candidates": {
                "items": {
                  "$ref": "#/$defs/WalkingCandidate"
                },
                "maxItems": 30,
                "minItems": 1,
                "title": "Candidates",
                "type": "array"
              },
              "decision_at": {
                "format": "date-time",
                "title": "Decision At",
                "type": "string"
              },
              "max_walk_minutes": {
