{
  "status": "in_process_prototype_no_mcp_server",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "inputSchema": {
        "$defs": {
          "SearchQuery": {
            "additionalProperties": false,
            "properties": {
              "decision_at": {
                "format": "date-time",
                "title": "Decision At",
                "type": "string"
              },
              "latitude": {
                "maximum": 90,
                "minimum": -90,
                "title": "Latitude",
                "type": "number"
              },
              "limit": {
                "default": 20,
                "maximum": 30,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              },
              "longitude": {
                "maximum": 180,
                "minimum": -180,
                "title": "Longitude",
                "type": "number"
              },
              "radius_m": {
                "exclusiveMinimum": 0,
                "maximum": 10000,
                "title": "Radius M",
                "type": "number"
              }
            },
            "required": [
              "longitude",
              "latitude",
              "radius_m",
              "decision_at"
            ],
            "title": "SearchQuery",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "city_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "City Id",
            "type": "string"
          },
          "query": {
            "$ref": "#/$defs/SearchQuery"
          }
        },
        "required": [
          "city_id",
          "query"
        ],
        "title": "SearchToolInput",
        "type": "object"
      },
      "name": "search_places"
    },
    {
