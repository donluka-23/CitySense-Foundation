            "APIKeyHeader": []
          }
        ],
        "summary": "Comparison",
        "tags": [
          "private-agent-read"
        ]
      }
    },
    "/v1/cities/{city_id}/places": {
      "get": {
        "operationId": "search_places",
        "parameters": [
          {
            "in": "path",
            "name": "city_id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "title": "City Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "longitude",
            "required": true,
            "schema": {
              "maximum": 180,
              "minimum": -180,
              "title": "Longitude",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "latitude",
            "required": true,
            "schema": {
              "maximum": 90,
              "minimum": -90,
              "title": "Latitude",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "radius_m",
            "required": true,
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "Radius M",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "decision_at",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Decision At",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 30,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Search",
        "tags": [
          "private-agent-read"
        ]
      }
    },
