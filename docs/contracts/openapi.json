              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "title": "City Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComparisonQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
