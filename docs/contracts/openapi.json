{
  "components": {
    "schemas": {
      "ComparisonQuery": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/WalkingCandidate"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Candidates",
            "type": "array"
          },
          "decision_at": {
            "format": "date-time",
            "title": "Decision At",
            "type": "string"
          },
          "max_walk_minutes": {
            "default": 45,
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Max Walk Minutes",
            "type": "number"
          },
          "need": {
            "$ref": "#/components/schemas/Need"
          },
          "target_time": {
            "format": "date-time",
            "title": "Target Time",
            "type": "string"
          }
        },
        "required": [
          "decision_at",
          "target_time",
          "need",
          "candidates"
        ],
        "title": "ComparisonQuery",
        "type": "object"
      },
      "DataKind": {
        "enum": [
          "observed",
          "forecast",
          "derived",
          "estimated_proxy",
          "unavailable"
        ],
        "title": "DataKind",
        "type": "string"
      },
      "EvaluateRequest": {
        "additionalProperties": false,
        "properties": {
          "decision_at": {
            "format": "date-time",
            "title": "Decision At",
            "type": "string"
          },
          "max_walk_minutes": {
            "default": 45,
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Max Walk Minutes",
            "type": "number"
          },
          "need": {
            "$ref": "#/components/schemas/Need"
          },
          "places": {
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Places",
            "type": "array"
          },
          "target_time": {
            "format": "date-time",
            "title": "Target Time",
            "type": "string"
          }
        },
        "required": [
          "need",
          "decision_at",
          "target_time",
          "places"
        ],
        "title": "EvaluateRequest",
        "type": "object"
      },
      "EvaluateResponse": {
        "additionalProperties": false,
        "properties": {
          "candidate_ids": {
            "items": {
              "type": "string"
            },
            "title": "Candidate Ids",
            "type": "array"
          },
          "excluded": {
            "items": {
              "type": "string"
            },
            "title": "Excluded",
            "type": "array"
          },
          "exclusions": {
            "items": {
              "$ref": "#/components/schemas/Exclusion"
            },
            "title": "Exclusions",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "parameter_hash": {
            "title": "Parameter Hash",
            "type": "string"
          },
          "ranked": {
            "items": {
              "$ref": "#/components/schemas/RankedPlace"
            },
            "title": "Ranked",
            "type": "array"
          },
          "warning": {
            "title": "Warning",
            "type": "string"
          }
        },
        "required": [
          "model_version",
          "parameter_hash",
          "candidate_ids",
          "ranked",
          "excluded",
          "exclusions",
          "warning"
        ],
        "title": "EvaluateResponse",
        "type": "object"
      },
      "EvidenceResult": {
        "additionalProperties": false,
        "properties": {
          "age_seconds": {
            "minimum": 0.0,
            "title": "Age Seconds",
            "type": "number"
          },
          "evidence": {
            "$ref": "#/components/schemas/Observation"
          },
          "freshness": {
            "enum": [
              "within_model_limit",
              "stale",
              "unavailable"
            ],
            "title": "Freshness",
            "type": "string"
          },
          "rights": {
            "$ref": "#/components/schemas/SourceMetadata"
          },
          "uncertainty": {
            "items": {
              "type": "string"
            },
            "title": "Uncertainty",
            "type": "array"
          },
          "verification_status": {
            "const": "source_reported_unverified",
            "default": "source_reported_unverified",
            "title": "Verification Status",
            "type": "string"
          }
        },
        "required": [
          "evidence",
          "age_seconds",
          "freshness",
          "rights",
          "uncertainty"
        ],
        "title": "EvidenceResult",
        "type": "object"
      },
      "Exclusion": {
        "additionalProperties": false,
        "properties": {
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "place_id",
          "reason"
        ],
        "title": "Exclusion",
        "type": "object"
      },
      "Feature": {
        "additionalProperties": false,
        "properties": {
          "data_kind": {
            "$ref": "#/components/schemas/DataKind"
          },
          "issued_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issued At"
          },
          "license_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "License Id",
            "type": "string"
          },
          "method_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Method Version",
            "type": "string"
          },
          "observation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Id"
          },
          "observed_or_valid_at": {
            "format": "date-time",
            "title": "Observed Or Valid At",
            "type": "string"
          },
          "quality": {
            "$ref": "#/components/schemas/FeatureQuality"
          },
          "quality_metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 20,
            "title": "Quality Metadata",
            "type": "object"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Version",
            "type": "string"
          },
          "spatial_resolution_m": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spatial Resolution M"
          },
          "unit": {
            "const": "fraction",
            "title": "Unit",
            "type": "string"
          },
          "valid_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "value": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "quality",
          "data_kind",
          "source_id",
          "source_version",
          "license_id",
          "method_version",
          "unit",
          "observed_or_valid_at",
          "retrieved_at"
        ],
        "title": "Feature",
        "type": "object"
      },
      "FeatureQuality": {
        "enum": [
          "regional_forecast",
          "derived_spatial",
          "observed_manual",
          "measured_local",
          "reported_provider",
          "unknown"
        ],
        "title": "FeatureQuality",
        "type": "string"
      },
      "Geometry": {
        "additionalProperties": false,
        "properties": {
          "coordinates": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              }
            ],
            "title": "Coordinates",
            "type": "array"
          },
          "license_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "License Id",
            "type": "string"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "revision_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision Id"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Version",
            "type": "string"
          },
          "spatial_accuracy_m": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spatial Accuracy M"
          },
          "srid": {
            "const": 4326,
            "default": 4326,
            "title": "Srid",
            "type": "integer"
          },
          "type": {
            "const": "Point",
            "default": "Point",
            "title": "Type",
            "type": "string"
          },
          "valid_at": {
            "format": "date-time",
            "title": "Valid At",
            "type": "string"
          },
          "verification_status": {
            "const": "source_reported_unverified",
            "default": "source_reported_unverified",
            "title": "Verification Status",
            "type": "string"
          }
        },
        "required": [
          "coordinates",
          "revision_id",
          "valid_at",
          "retrieved_at",
          "source_id",
          "source_version",
          "license_id"
        ],
        "title": "Geometry",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Need": {
        "enum": [
          "cool_walk",
          "quiet_rest",
          "family_walk"
        ],
        "title": "Need",
        "type": "string"
      },
      "Observation": {
        "additionalProperties": false,
        "properties": {
          "data_kind": {
            "$ref": "#/components/schemas/DataKind"
          },
          "feature_key": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Feature Key",
            "type": "string"
          },
          "issued_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issued At"
          },
          "license_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "License Id",
            "type": "string"
          },
          "method_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Method Version",
            "type": "string"
          },
          "observation_id": {
            "format": "uuid",
            "title": "Observation Id",
            "type": "string"
          },
          "observed_or_valid_at": {
            "format": "date-time",
            "title": "Observed Or Valid At",
            "type": "string"
          },
          "place_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Place Id",
            "type": "string"
          },
          "quality": {
            "$ref": "#/components/schemas/FeatureQuality"
          },
          "quality_metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 20,
            "title": "Quality Metadata",
            "type": "object"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Version",
            "type": "string"
          },
          "spatial_resolution_m": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spatial Resolution M"
          },
          "unit": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          },
          "valid_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "quality",
          "data_kind",
          "source_id",
          "source_version",
          "license_id",
          "method_version",
          "unit",
          "observed_or_valid_at",
          "retrieved_at",
          "observation_id",
          "place_id",
          "feature_key"
        ],
        "title": "Observation",
        "type": "object"
      },
      "Place": {
        "additionalProperties": false,
        "properties": {
          "feature_greenery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Feature"
              },
              {
                "type": "null"
              }
            ]
          },
          "feature_shade": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Feature"
              },
              {
                "type": "null"
              }
            ]
          },
          "feature_traffic_proximity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Feature"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "place_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Place Id",
            "type": "string"
          },
          "walk_minutes": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Walk Minutes",
            "type": "number"
          }
        },
        "required": [
          "place_id",
          "name",
          "walk_minutes"
        ],
        "title": "Place",
        "type": "object"
      },
      "PlaceResult": {
        "additionalProperties": false,
        "properties": {
          "city_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "City Id",
            "type": "string"
          },
          "geometry": {
            "$ref": "#/components/schemas/Geometry"
          },
          "model_version": {
            "const": "not_applicable",
            "default": "not_applicable",
            "title": "Model Version",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "place_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Place Id",
            "type": "string"
          },
          "rights": {
            "$ref": "#/components/schemas/SourceMetadata"
          },
          "uncertainty": {
            "items": {
              "type": "string"
            },
            "title": "Uncertainty",
            "type": "array"
          }
        },
        "required": [
          "place_id",
          "city_id",
          "name",
          "geometry",
          "rights"
        ],
        "title": "PlaceResult",
        "type": "object"
      },
      "RankedPlace": {
        "additionalProperties": false,
        "properties": {
          "components": {
            "items": {
              "$ref": "#/components/schemas/ScoreComponent"
            },
            "title": "Components",
            "type": "array"
          },
          "confidence": {
            "enum": [
              "unvalidated",
              "insufficient_evidence"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "coverage": {
            "title": "Coverage",
            "type": "number"
          },
          "place_id": {
            "title": "Place Id",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "status": {
            "enum": [
              "insufficient_data",
              "scored_unvalidated"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "place_id",
          "score",
          "coverage",
          "status",
          "reasons",
          "components",
          "confidence"
        ],
        "title": "RankedPlace",
        "type": "object"
      },
      "ScoreComponent": {
        "additionalProperties": false,
        "properties": {
          "contribution": {
            "title": "Contribution",
            "type": "number"
          },
          "data_kind": {
            "$ref": "#/components/schemas/DataKind"
          },
          "feature_key": {
            "title": "Feature Key",
            "type": "string"
          },
          "quality": {
            "$ref": "#/components/schemas/FeatureQuality"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "feature_key",
          "value",
          "weight",
          "contribution",
          "data_kind",
          "quality",
          "source_id"
        ],
        "title": "ScoreComponent",
        "type": "object"
      },
      "SearchResult": {
        "additionalProperties": false,
        "properties": {
          "city_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "City Id",
            "type": "string"
          },
          "decision_at": {
            "format": "date-time",
            "title": "Decision At",
            "type": "string"
          },
          "limit": {
            "title": "Limit",
            "type": "integer"
          },
          "places": {
            "items": {
              "$ref": "#/components/schemas/PlaceResult"
            },
            "title": "Places",
            "type": "array"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "city_id",
          "decision_at",
          "places",
          "limit",
          "truncated"
        ],
        "title": "SearchResult",
        "type": "object"
      },
      "SourceMetadata": {
        "additionalProperties": false,
        "properties": {
          "attribution_required": {
            "title": "Attribution Required",
            "type": "boolean"
          },
          "cache_allowed": {
            "title": "Cache Allowed",
            "type": "boolean"
          },
          "commercial_allowed": {
            "title": "Commercial Allowed",
            "type": "boolean"
          },
          "license_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "License Id",
            "type": "string"
          },
          "redistribution_allowed": {
            "title": "Redistribution Allowed",
            "type": "boolean"
          },
          "research_allowed": {
            "title": "Research Allowed",
            "type": "boolean"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "source_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Id",
            "type": "string"
          },
          "source_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Source Version",
            "type": "string"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "terms_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terms Url"
          }
        },
        "required": [
          "source_id",
          "source_version",
          "license_id",
          "synthetic",
          "research_allowed",
          "commercial_allowed",
          "cache_allowed",
          "redistribution_allowed",
          "attribution_required"
        ],
        "title": "SourceMetadata",
        "type": "object"
      },
      "StateQuery": {
        "additionalProperties": false,
        "properties": {
          "decision_at": {
            "format": "date-time",
            "title": "Decision At",
            "type": "string"
          },
          "place_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Place Ids",
            "type": "array"
          },
          "target_time": {
            "format": "date-time",
            "title": "Target Time",
            "type": "string"
          }
        },
        "required": [
          "decision_at",
          "target_time",
          "place_ids"
        ],
        "title": "StateQuery",
        "type": "object"
      },
      "StateResult": {
        "additionalProperties": false,
        "properties": {
          "city_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "City Id",
            "type": "string"
          },
          "decision_at": {
            "format": "date-time",
            "title": "Decision At",
            "type": "string"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/EvidenceResult"
            },
            "title": "Features",
            "type": "array"
          },
          "missing_features": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Missing Features",
            "type": "object"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "parameter_hash": {
            "title": "Parameter Hash",
            "type": "string"
          },
          "places": {
            "items": {
              "$ref": "#/components/schemas/PlaceResult"
            },
            "title": "Places",
            "type": "array"
          },
          "target_time": {
            "format": "date-time",
            "title": "Target Time",
            "type": "string"
          },
          "warning": {
            "default": "Sparse place evidence; not a measured psychological or citywide state",
            "title": "Warning",
            "type": "string"
          }
        },
        "required": [
          "city_id",
          "decision_at",
          "target_time",
          "places",
          "features",
          "missing_features",
          "model_version",
          "parameter_hash"
        ],
        "title": "StateResult",
        "type": "object"
      },
      "SuitabilityQuery": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/WalkingCandidate"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Candidates",
            "type": "array"
          },
          "decision_at": {
            "format": "date-time",
            "title": "Decision At",
            "type": "string"
          },
          "max_walk_minutes": {
            "default": 45,
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Max Walk Minutes",
            "type": "number"
          },
          "need": {
            "$ref": "#/components/schemas/Need"
          },
          "target_time": {
            "format": "date-time",
            "title": "Target Time",
            "type": "string"
          }
        },
        "required": [
          "decision_at",
          "target_time",
          "need",
          "candidates"
        ],
        "title": "SuitabilityQuery",
        "type": "object"
      },
      "SuitabilityResult": {
        "additionalProperties": false,
        "properties": {
          "assessment": {
            "$ref": "#/components/schemas/EvaluateResponse"
          },
          "city_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "City Id",
            "type": "string"
          },
          "evidence_origin": {
            "const": "stored_database",
            "default": "stored_database",
            "title": "Evidence Origin",
            "type": "string"
          },
          "inputs": {
            "$ref": "#/components/schemas/EvaluateRequest"
          },
          "state": {
            "$ref": "#/components/schemas/StateResult"
          },
          "walking_time_warning": {
            "default": "Walking times are unverified caller estimates; no routing/accessibility guarantee",
            "title": "Walking Time Warning",
            "type": "string"
          }
        },
        "required": [
          "city_id",
          "state",
          "assessment",
          "inputs"
        ],
        "title": "SuitabilityResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WalkingCandidate": {
        "additionalProperties": false,
        "properties": {
          "place_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "title": "Place Id",
            "type": "string"
          },
          "walk_minutes": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Walk Minutes",
            "type": "number"
          },
          "walking_time_source": {
            "const": "caller_estimate",
            "default": "caller_estimate",
            "title": "Walking Time Source",
            "type": "string"
          }
        },
        "required": [
          "place_id",
          "walk_minutes"
        ],
        "title": "WalkingCandidate",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
